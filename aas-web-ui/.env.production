# =============================================================================
# BaSyx AAS Web UI - Production Configuration
# =============================================================================
# Diese Datei wird beim Build (yarn build) automatisch geladen.
# Alle VITE_* Variablen sind zur Build-Zeit fix eingebaut.
#
# Tipp: Für Infrastructure-URLs kannst du auch public/config/basyx-infra.yml
# verwenden - die wird zur Laufzeit geladen und ist flexibler.
# =============================================================================

# -----------------------------------------------------------------------------
# Base Path (falls die App nicht im Root gehostet wird, z.B. "/aas-ui/")
# -----------------------------------------------------------------------------
BASE=/
VITE_BASE_PATH=/

# -----------------------------------------------------------------------------
# Branding / Theming
# -----------------------------------------------------------------------------
VITE_LOGO_LIGHT_PATH="Logo_light.svg"
VITE_LOGO_DARK_PATH="Logo_dark.svg"
VITE_PRIMARY_LIGHT_COLOR="#019b9f"
VITE_PRIMARY_DARK_COLOR="#019b9f"

# -----------------------------------------------------------------------------
# BaSyx Component URLs
# -----------------------------------------------------------------------------
VITE_AAS_DISCOVERY_PATH=
VITE_AAS_REGISTRY_PATH=https://aas.durablox.net
VITE_SUBMODEL_REGISTRY_PATH=https://aas.durablox.net
VITE_AAS_REPO_PATH=https://aas.durablox.net
VITE_SUBMODEL_REPO_PATH=https://aas.durablox.net
VITE_CD_REPO_PATH=

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
# Zeigt den Endpoint-Config Dialog (User kann URLs selbst eingeben)
VITE_ENDPOINT_CONFIG_AVAILABLE=false

# Single AAS Mode (nur ein AAS anzeigen, kein Wechsel möglich)
VITE_SINGLE_AAS=false
VITE_SINGLE_AAS_REDIRECT=

# Submodel Viewer/Editor Features
VITE_SM_VIEWER_EDITOR=true
VITE_ALLOW_EDITING=false
VITE_ALLOW_UPLOADING=false
VITE_ALLOW_LOGOUT=true

# Editor ID Prefix für neue Elemente
VITE_EDITOR_ID_PREFIX="https://example.com/"

# -----------------------------------------------------------------------------
# Authentication - Keycloak (OAuth2/OIDC)
# -----------------------------------------------------------------------------
VITE_KEYCLOAK_ACTIVE=false
VITE_KEYCLOAK_URL=
VITE_KEYCLOAK_REALM=
VITE_KEYCLOAK_CLIENT_ID=
VITE_KEYCLOAK_FEATURE_CONTROL=false
VITE_KEYCLOAK_FEATURE_CONTROL_ROLE_PREFIX="basyx-aas-web-ui-feature-"

# -----------------------------------------------------------------------------
# Authentication - Generic OIDC
# -----------------------------------------------------------------------------
VITE_OIDC_ACTIVE=false
VITE_OIDC_URL=
VITE_OIDC_SCOPE=
VITE_OIDC_CLIENT_ID=

# -----------------------------------------------------------------------------
# Authentication - Basic Auth
# -----------------------------------------------------------------------------
VITE_BASIC_AUTH_ACTIVE=false
VITE_BASIC_AUTH_USERNAME=
VITE_BASIC_AUTH_PASSWORD=

# -----------------------------------------------------------------------------
# Authentication - Preconfigured (Client Credentials Flow)
# -----------------------------------------------------------------------------
VITE_PRECONFIGURED_AUTH=false
VITE_PRECONFIGURED_AUTH_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Authorization Header
# -----------------------------------------------------------------------------
VITE_AUTHORIZATION_HEADER_PREFIX="Bearer"
VITE_AUTHORIZATION_HEADER_DESCRIPTION_ENDPOINT_EXEMPTION=true

# -----------------------------------------------------------------------------
# InfluxDB (für Time Series Daten)
# -----------------------------------------------------------------------------
VITE_INFLUXDB_TOKEN=
